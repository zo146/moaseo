<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>상품 관리 - 모아서 관리자</title>
    <style>
        *{box-sizing:border-box;margin:0;padding:0}
        body{font-family:'Malgun Gothic','Apple SD Gothic Neo',-apple-system,sans-serif;background:#f8f8f6;color:#1a1a1a}
        a{text-decoration:none;color:inherit}

        .topbar{background:#1a1a1a;padding:9px 0;font-size:11.5px;color:#888;letter-spacing:.3px}
        .topbar-inner{max-width:1280px;margin:0 auto;padding:0 32px;display:flex;justify-content:space-between;align-items:center}
        .topbar-left{font-size:11px;font-weight:700;letter-spacing:2px;color:#9b7f5a}
        .topbar-right{display:flex;gap:0}
        .topbar a{color:#888;transition:color .2s}
        .topbar a:hover{color:#fff}
        .t-sep{margin:0 12px;color:#3a3a3a}

        .header{background:#fff;border-bottom:1px solid #e2e0db}
        .header-inner{max-width:1280px;margin:0 auto;padding:18px 32px;display:flex;align-items:center;justify-content:space-between}
        .logo{display:flex;flex-direction:column;cursor:pointer}
        .logo-text{font-size:26px;font-weight:900;letter-spacing:-1.5px;color:#1a1a1a;line-height:1}
        .logo-sub{font-size:9.5px;letter-spacing:3px;color:#9b7f5a;margin-top:3px;text-transform:uppercase;font-weight:700}

        .header-actions{display:flex;gap:8px}
        .btn-hd{padding:8px 20px;font-size:12px;font-weight:700;letter-spacing:.5px;cursor:pointer;border:1.5px solid #ddd;background:#fff;color:#666;transition:all .2s}
        .btn-hd:hover{border-color:#1a1a1a;color:#1a1a1a}
        .btn-hd.primary{background:#1a1a1a;color:#fff;border-color:#1a1a1a}
        .btn-hd.primary:hover{background:#9b7f5a;border-color:#9b7f5a}

        .admin-gnb{background:#1a1a1a;border-bottom:3px solid #9b7f5a}
        .admin-gnb-inner{max-width:1280px;margin:0 auto;padding:0 32px;display:flex;align-items:center}
        .admin-gnb a{display:flex;align-items:center;height:42px;padding:0 20px;font-size:12.5px;font-weight:700;color:rgba(255,255,255,.6);letter-spacing:.8px;border-bottom:3px solid transparent;transition:all .2s}
        .admin-gnb a:hover,.admin-gnb a.active{color:#fff;border-bottom-color:#9b7f5a}

        .page-wrap{max-width:1100px;margin:40px auto;padding:0 32px 80px}

        .page-hd{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:28px;padding-bottom:16px;border-bottom:1.5px solid #1a1a1a}
        .page-title{font-size:22px;font-weight:900;letter-spacing:-1px}
        .page-title span{font-size:12px;font-weight:400;color:#aaa;letter-spacing:2px;margin-left:10px}
        .product-count{font-size:12.5px;color:#888}

        /* 테이블 */
        .admin-table{width:100%;border-collapse:collapse;background:#fff;border:1px solid #e2e0db}
        .admin-table th{background:#faf9f7;border-bottom:1.5px solid #e2e0db;padding:13px 16px;font-size:11.5px;font-weight:700;color:#888;letter-spacing:1px;text-align:center}
        .admin-table td{padding:16px;border-bottom:1px solid #f2f2f0;vertical-align:middle;text-align:center;font-size:13.5px}
        .admin-table tr:last-child td{border-bottom:none}
        .admin-table tr:hover td{background:#faf9f7}

        .prod-img{width:54px;height:54px;object-fit:cover;border:1px solid #e2e0db}
        .prod-name{text-align:left;font-weight:700;color:#1a1a1a}
        .prod-id{font-size:11.5px;color:#ccc;font-weight:700}
        .prod-price{font-weight:900}
        .stock-badge{display:inline-block;padding:3px 10px;font-size:11px;font-weight:700;border-radius:20px}
        .stock-ok{background:#eaf4ea;color:#3a6b3a}
        .stock-low{background:#fff0f0;color:#c0392b}

        .btn-edit{padding:6px 14px;font-size:11.5px;font-weight:700;border:1.5px solid #ddd;background:#fff;color:#555;cursor:pointer;transition:all .2s;margin-right:4px;vertical-align:middle;display:inline-block}
        .btn-edit:hover{border-color:#1a1a1a;color:#1a1a1a}
        .btn-del{padding:6px 14px;font-size:11.5px;font-weight:700;border:1.5px solid #f0d0d0;background:#fff;color:#c0392b;cursor:pointer;transition:all .2s;vertical-align:middle;display:inline-block}
        .btn-del:hover{background:#c0392b;color:#fff;border-color:#c0392b}

        .empty-row td{padding:60px;color:#bbb;font-size:14px;letter-spacing:.5px}
    </style>
</head>
<body>

<div class="topbar">
    <div class="topbar-inner">
        <span class="topbar-left">🔐 ADMIN PANEL</span>
        <div class="topbar-right">
            <a href="/">쇼핑몰 홈</a>
            <span class="t-sep">|</span>
            <a href="/logout">로그아웃</a>
        </div>
    </div>
</div>

<div class="header">
    <div class="header-inner">
        <div class="logo" onclick="location.href='/'">
            <span class="logo-text">모아서</span>
            <span class="logo-sub">Admin System</span>
        </div>
        <div class="header-actions">
            <button class="btn-hd" onclick="location.href='/'">쇼핑몰 보기</button>
            <button class="btn-hd primary" onclick="location.href='/admin/add'">+ 새 상품 등록</button>
        </div>
    </div>
</div>

<nav class="admin-gnb">
    <div class="admin-gnb-inner">
        <a href="/admin" class="active">상품 관리</a>
    </div>
</nav>

<div class="page-wrap">
    <div class="page-hd">
        <div class="page-title">상품 관리 <span>PRODUCT LIST</span></div>
        <span class="product-count">총 <%= products ? products.length : 0 %>개 상품</span>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th style="width:60px">ID</th>
                <th style="width:80px">이미지</th>
                <th style="text-align:left">상품명</th>
                <th style="width:100px">카테고리</th>
                <th style="width:80px">월</th>
                <th style="width:120px">가격</th>
                <th style="width:90px">재고</th>
                <th style="width:140px">관리</th>
            </tr>
        </thead>
        <tbody>
            <% if (products && products.length > 0) { %>
                <% products.forEach(product => { %>
                <tr>
                    <td><span class="prod-id">#<%= product.id %></span></td>
                    <td><img src="<%= product.image_url %>" class="prod-img" onerror="this.src='/images/default.jpg'"></td>
                    <td class="prod-name"><%= product.name %></td>
                    <td><%= product.category %></td>
                    <td><%= product.target_month %>월</td>
                    <td class="prod-price"><%= product.price.toLocaleString() %>원</td>
                    <td>
                        <span class="stock-badge <%= product.stock > 0 ? 'stock-ok' : 'stock-low' %>">
                            <%= product.stock > 0 ? product.stock+'개' : '품절' %>
                        </span>
                    </td>
                    <td style="white-space:nowrap;vertical-align:middle">
                        <a href="/admin/edit/<%= product.id %>"><button class="btn-edit">수정</button></a>
                        <button class="btn-del" onclick="deleteProduct('<%= product.id %>')">삭제</button>
                    </td>
                </tr>
                <% }) %>
            <% } else { %>
                <tr class="empty-row">
                    <td colspan="8">등록된 상품이 없습니다</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<script>
    function deleteProduct(id) {
        if(confirm('정말 삭제하시겠습니까?\n삭제된 데이터는 복구할 수 없습니다.')) {
            location.href = '/admin/delete/' + id;
        }
    }
</script>
</body>
</html>