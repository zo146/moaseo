<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>모아서</title>
    <style>
        *{box-sizing:border-box;margin:0;padding:0}
        body{font-family:'Malgun Gothic','Apple SD Gothic Neo',-apple-system,sans-serif;background:#f8f8f6;color:#1a1a1a}
        a{text-decoration:none;color:inherit}
        ul{list-style:none}

        :root{--p:#1a1a1a;--acc:#9b7f5a;--acc-l:#f5f0ea;--line:#e2e0db}
        body.theme-수산물{--acc:#2a6496;--acc-l:#eaf3fa;--line:#d0e4f0}
        body.theme-농산물{--acc:#3a6b3a;--acc-l:#eaf4ea;--line:#cde3cd}
        body.theme-의류{--acc:#5a4a7a;--acc-l:#f0edf8;--line:#ddd6ee}

        .topbar{background:#1a1a1a;padding:9px 0;font-size:11.5px;color:#888;letter-spacing:.3px}
        .topbar-inner{max-width:1280px;margin:0 auto;padding:0 32px;display:flex;justify-content:flex-end;align-items:center}
        .topbar a{color:#888;transition:color .2s}
        .topbar a:hover{color:#fff}
        .t-sep{margin:0 12px;color:#3a3a3a}
        .t-hi{color:#c8a97a;font-weight:600}

        .header{background:#fff;border-bottom:1px solid var(--line)}
        .header-inner{max-width:1280px;margin:0 auto;padding:20px 32px;display:flex;align-items:center;gap:32px}
        .logo{display:flex;flex-direction:column;cursor:pointer;margin-right:12px;flex-shrink:0}
        .logo-text{font-size:26px;font-weight:900;letter-spacing:-1.5px;color:#1a1a1a;line-height:1}
        .logo-sub{font-size:9.5px;letter-spacing:3px;color:#aaa;margin-top:3px;text-transform:uppercase}

        .search-outer{flex:1;max-width:520px;position:relative}
        .search-inner{display:flex;border:1.5px solid #1a1a1a;height:44px}
        .search-inner input{flex:1;border:none;padding:0 18px;font-size:13.5px;outline:none;background:#fff;letter-spacing:.2px}
        .search-inner input::placeholder{color:#bbb}
        .search-inner button{background:#1a1a1a;color:#fff;border:none;padding:0 22px;font-size:12.5px;font-weight:700;cursor:pointer;letter-spacing:1px;transition:background .2s}
        .search-inner button:hover{background:var(--acc)}

        .search-dropdown{position:absolute;top:44px;left:0;width:100%;background:#fff;border:1.5px solid #1a1a1a;border-top:none;z-index:9999;display:none}
        .search-dropdown.show{display:block}
        .dropdown-header{display:flex;justify-content:space-between;align-items:center;padding:10px 16px;border-bottom:1px solid #f0ede8}
        .dropdown-header span{font-size:11px;font-weight:700;color:#888;letter-spacing:1px}
        .clear-all{font-size:11px;color:#aaa;cursor:pointer;transition:color .2s;background:none;border:none}
        .clear-all:hover{color:#c0392b}
        .history-item{display:flex;align-items:center;justify-content:space-between;padding:10px 16px;cursor:pointer;transition:background .15s;border-bottom:1px solid #f8f8f6}
        .history-item:last-child{border-bottom:none}
        .history-item:hover{background:#f8f8f6}
        .history-left{display:flex;align-items:center;gap:10px;flex:1}
        .history-clock{font-size:13px;color:#bbb}
        .history-text{font-size:13.5px;color:#333}
        .history-del{font-size:18px;color:#ccc;cursor:pointer;padding:0 4px;transition:color .2s;line-height:1;background:none;border:none}
        .history-del:hover{color:#c0392b}
        .no-history{padding:18px 16px;text-align:center;font-size:12.5px;color:#bbb;letter-spacing:.5px}

        .hd-actions{display:flex;gap:2px;margin-left:auto}
        .hd-btn{display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px 16px;font-size:10.5px;color:#666;background:none;border:none;cursor:pointer;letter-spacing:.5px;transition:color .2s}
        .hd-btn:hover{color:var(--acc)}
        .hd-ico{font-size:19px;line-height:1}

        .gnb{background:#fff;border-bottom:1.5px solid #1a1a1a}
        .gnb-inner{max-width:1280px;margin:0 auto;padding:0 32px;display:flex}
        .gnb a{display:flex;align-items:center;height:44px;padding:0 22px;font-size:13px;font-weight:700;color:#444;letter-spacing:.8px;border-bottom:2.5px solid transparent;transition:all .2s}
        .gnb a:hover,.gnb a.active{color:#1a1a1a;border-bottom-color:#1a1a1a}

        .wrap{max-width:1280px;margin:32px auto;padding:0 32px;display:flex;gap:28px}
        .sidebar{width:196px;flex-shrink:0}
        .sb-cat{background:#fff;border:1px solid var(--line)}
        .sb-cat-hd{padding:16px 18px;font-size:11px;font-weight:700;letter-spacing:2px;color:#888;border-bottom:1px solid var(--line);background:#faf9f7}
        .sb-cat-list li a{display:flex;align-items:center;justify-content:space-between;padding:13px 18px;font-size:13.5px;color:#333;border-bottom:1px solid #f5f5f3;transition:all .18s;letter-spacing:.2px}
        .sb-cat-list li:last-child a{border-bottom:none}
        .sb-cat-list li a:hover,.sb-cat-list li a.on{background:var(--acc-l);color:var(--acc);font-weight:700}
        .sb-arr{font-size:10px;color:#ccc}

        .content{flex:1;min-width:0}
        .sec-hd{display:flex;align-items:flex-end;gap:10px;margin-bottom:20px;padding-bottom:14px;border-bottom:1px solid var(--line)}
        .sec-ttl{font-size:18px;font-weight:900;letter-spacing:-.5px;color:#1a1a1a}
        .sec-en{font-size:10.5px;font-weight:700;letter-spacing:3px;color:#bbb;margin-left:4px}

        .slider-wrap{position:relative;overflow:hidden;background:#fff;border:1px solid var(--line);margin-bottom:36px}
        .slider-track{display:flex;transition:transform .8s cubic-bezier(.4,0,.2,1)}
        .slide{min-width:100%;display:flex;height:320px}
        .slide-img-col{width:55%;position:relative;overflow:hidden;background:#f0ece4}
        .slide-img-col img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s}
        .slide:hover .slide-img-col img{transform:scale(1.03)}
        .slide-info-col{width:45%;padding:40px 44px;display:flex;flex-direction:column;justify-content:center;gap:12px;background:#fff}
        .slide-rank{font-size:10px;font-weight:700;letter-spacing:3px;color:var(--acc);border-bottom:1px solid var(--acc);padding-bottom:6px;display:inline-block;margin-bottom:4px}
        .slide-name{font-size:22px;font-weight:900;color:#1a1a1a;line-height:1.35;letter-spacing:-.5px}
        .slide-price{font-size:26px;font-weight:900;color:#1a1a1a;letter-spacing:-1px}
        .slide-price em{font-size:14px;font-weight:400;color:#888;font-style:normal;margin-left:4px}
        .slide-cta{display:inline-flex;align-items:center;gap:8px;background:#1a1a1a;color:#fff;padding:13px 28px;font-size:12.5px;font-weight:700;letter-spacing:1.5px;cursor:pointer;transition:background .2s;width:fit-content;margin-top:4px}
        .slide-cta:hover{background:var(--acc)}
        .slider-dots{position:absolute;bottom:16px;right:20px;display:flex;gap:6px}
        .dot{width:6px;height:6px;border-radius:50%;background:#ccc;cursor:pointer;transition:all .25s}
        .dot.on{background:var(--acc);width:20px;border-radius:3px}
        .slider-arrows{position:absolute;top:50%;transform:translateY(-50%);width:100%;display:flex;justify-content:space-between;pointer-events:none;padding:0 16px}
        .arr-btn{width:38px;height:38px;background:rgba(255,255,255,.92);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:15px;cursor:pointer;pointer-events:all;color:#555;transition:all .2s}
        .arr-btn:hover{background:#1a1a1a;color:#fff;border-color:#1a1a1a}

        .month-wrap{background:#fff;border:1px solid var(--line);margin-bottom:40px}
        .month-tabs{display:grid;grid-template-columns:repeat(6,1fr);border-bottom:1px solid var(--line)}
        .m-tab{padding:11px 0;text-align:center;font-size:12.5px;font-weight:700;color:#aaa;letter-spacing:.5px;cursor:pointer;border-bottom:2.5px solid transparent;transition:all .18s;background:#fafaf9;user-select:none}
        .m-tab:hover{color:#555;background:#f3f3f1}
        .m-tab.on{color:#1a1a1a;border-bottom-color:#1a1a1a;background:#fff}
        .month-grid-wrap{display:grid;grid-template-columns:repeat(6,1fr);gap:1px;background:var(--line)}
        .m-col{background:#fff;padding:12px 8px;display:flex;flex-direction:column;gap:7px;transition:background .2s}
        .m-col.highlight{background:var(--acc-l)}
        .m-col-header{display:none}
        .m-card{border:1px solid #f0ede8;cursor:pointer;transition:all .18s;background:#fff;position:relative}
        .m-card:hover{border-color:var(--acc);box-shadow:0 4px 16px rgba(0,0,0,.08)}
        .m-img{width:100%;height:76px;object-fit:cover;display:block;background:#f5f3ef}
        .m-body{padding:6px 7px 8px}
        .m-name{font-size:11px;color:#333;line-height:1.4;height:30px;overflow:hidden;margin-bottom:2px}
        .m-price{font-size:12px;font-weight:900;color:#1a1a1a}
        .m-cat-icon{position:absolute;bottom:8px;right:7px;font-size:13px;opacity:.7}
        .m-empty-card{border:1px solid #f0ede8;background:#faf9f7;display:flex;align-items:center;justify-content:center;height:128px}
        .m-empty-txt{font-size:10px;color:#ccc;letter-spacing:1px}

        .half-float{position:fixed;right:16px;top:50%;transform:translateY(-50%);z-index:999;display:flex;flex-direction:column;align-items:center;background:#fff;border:1px solid #e0e0e0;border-radius:12px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.12)}
        .hf-toggle{width:44px;height:44px;display:flex;align-items:center;justify-content:center;cursor:pointer;background:#1a1a1a;border:none;position:relative;transition:background .2s}
        .hf-toggle:hover{background:#333}
        .hf-toggle-tip{position:absolute;right:52px;top:50%;transform:translateY(-50%);background:#1a1a1a;color:#fff;font-size:10.5px;font-weight:700;padding:4px 9px;border-radius:4px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .2s;letter-spacing:.5px}
        .hf-toggle:hover .hf-toggle-tip{opacity:1}
        .hf-group{overflow:hidden;max-height:0;transition:max-height .3s ease}
        .hf-group.open{max-height:200px}
        .half-sep{width:100%;height:1px;background:#efefef}
        .half-float-item{width:44px;height:44px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;background:#fff;border:none;position:relative}
        .half-float-item:hover{background:#f5f5f5}
        .half-float-item.on{background:#1a1a1a}
        .half-float-tip{position:absolute;right:52px;top:50%;transform:translateY(-50%);background:#1a1a1a;color:#fff;font-size:10.5px;font-weight:700;padding:4px 9px;border-radius:4px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .2s;letter-spacing:.5px}
        .half-float-item:hover .half-float-tip{opacity:1}
        .hf-label{width:44px;height:36px;display:flex;align-items:center;justify-content:center;font-size:10.5px;font-weight:700;color:#888;letter-spacing:.3px;cursor:pointer;transition:all .2s;background:#fff;border:none;position:relative;user-select:none}
        .hf-label:hover{background:#f5f5f5;color:#1a1a1a}
        .hf-label.on{background:#1a1a1a;color:#fff}
        .hf-label-tip{position:absolute;right:52px;top:50%;transform:translateY(-50%);background:#1a1a1a;color:#fff;font-size:10.5px;font-weight:700;padding:4px 9px;border-radius:4px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .2s;letter-spacing:.5px}
        .hf-label:hover .hf-label-tip{opacity:1}

        .star-rating-display { font-size: 14px; color: #ddd; position: relative; display: inline-flex; align-items: center; margin: 4px 0; }
        .star-rating-display .star { position: relative; display: inline-block; letter-spacing: -2px; }
        .star-rating-display .star.full { color: #ff9900; }
        .star-rating-display .star.half::before { content: '\2605'; color: #ff9900; position: absolute; left: 0; width: 50%; overflow: hidden; }
        .rating-value { color: #666; font-size: 12px; font-weight: 700; margin-left: 6px; }
    </style>
</head>

<body class="theme-<%= currentCategory %>">

<div class="topbar">
    <div class="topbar-inner">
        <a href="/admin">관리자</a><span class="t-sep">|</span>
        <% if (locals.user) { %>
            <span class="t-hi"><%= user.username %></span>님 안녕하세요<span class="t-sep">|</span>
            <a href="/logout">로그아웃</a>
        <% } else { %>
            <a href="/login">로그인</a><span class="t-sep">|</span>
            <a href="/signup">회원가입</a>
        <% } %>
    </div>
</div>

<div class="header">
    <div class="header-inner">
        <div class="logo" onclick="location.href='/'">
            <span class="logo-text">모아서</span>
            <span class="logo-sub">premium market</span>
        </div>

        <div class="search-outer" id="searchOuter">
            <div class="search-inner">
                <input type="text" id="searchInput"
                       placeholder="찾고 싶은 상품을 입력하세요"
                       autocomplete="off"
                       onfocus="showDropdown()"
                       onkeydown="handleKey(event)">
                <button onclick="doSearch()">SEARCH</button>
            </div>
            <div class="search-dropdown" id="searchDropdown">
                <div class="dropdown-header">
                    <span>🕐 최근 검색어</span>
                    <button class="clear-all" onclick="clearAll()">전체 삭제</button>
                </div>
                <div id="historyList"></div>
            </div>
        </div>

        <div class="hd-actions">
            <button class="hd-btn" onclick="location.href='/mypage'">
                 <span class="hd-ico">👤</span>MY PAGE
            </button>
            <button class="hd-btn" onclick="location.href='/my/orders'">
                <span class="hd-ico">📜</span>ORDER
            </button>
            <button class="hd-btn" onclick="location.href='/cart'">
                <span class="hd-ico">🛒</span>CART
            </button>
        </div>
    </div>
</div>

<nav class="gnb">
    <div class="gnb-inner">
        <a href="/category/수산물" class="<%= currentCategory==='수산물'?'active':'' %>">수산물</a>
        <a href="/category/농산물" class="<%= currentCategory==='농산물'?'active':'' %>">농산물</a>
        <a href="/category/의류" class="<%= currentCategory==='의류'?'active':'' %>">의류</a>
    </div>
</nav>

<div class="half-float">
    <button class="hf-toggle" id="hfToggle" onclick="toggleHalfGroup()">
        <span class="hf-toggle-tip">상반기 / 하반기</span>
        <svg width="18" height="14" viewBox="0 0 18 14" fill="none">
            <rect y="0" width="18" height="2" rx="1" fill="#fff"/>
            <rect y="6" width="18" height="2" rx="1" fill="#fff"/>
            <rect y="12" width="18" height="2" rx="1" fill="#fff"/>
        </svg>
    </button>
    <div class="hf-group" id="hfGroup">
        <div class="half-sep"></div>
        <div class="hf-label on" id="mgBtn1" onclick="switchGroup(1)">
            <span class="hf-label-tip">1~6월 상반기</span>
            상반기
        </div>
        <div class="half-sep"></div>
        <div class="hf-label" id="mgBtn2" onclick="switchGroup(2)">
            <span class="hf-label-tip">7~12월 하반기</span>
            하반기
        </div>
    </div>
    <div class="half-sep"></div>
    <div class="half-float-item" onclick="location.href='/mypage'">
        <span class="half-float-tip">마이페이지</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
        </svg>
    </div>
    <div class="half-sep"></div>
    <div class="half-float-item" onclick="location.href='/cart'">
        <span class="half-float-tip">장바구니</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2" stroke-linecap="round">
            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
    </div>
    <div class="half-sep"></div>
    <div class="half-float-item" onclick="location.href='/my/orders'">
        <span class="half-float-tip">주문내역</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2" stroke-linecap="round">
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
        </svg>
    </div>
</div>

<div class="wrap">
    <aside class="sidebar">
        <div class="sb-cat">
            <div class="sb-cat-hd">CATEGORY</div>
            <ul class="sb-cat-list">
                <li><a href="/category/수산물" class="<%= currentCategory==='수산물'?'on':'' %>">🐟 수산물<span class="sb-arr">▶</span></a></li>
                <li><a href="/category/농산물" class="<%= currentCategory==='농산물'?'on':'' %>">🥦 농산물<span class="sb-arr">▶</span></a></li>
                <li><a href="/category/의류" class="<%= currentCategory==='의류'?'on':'' %>">👕 의류<span class="sb-arr">▶</span></a></li>
            </ul>
        </div>
    </aside>

    <aside class="content">
        <div class="sec-hd">
            <span class="sec-ttl">베스트 상품</span>
            <span class="sec-en">BEST ITEMS</span>
        </div>

        <div class="slider-wrap" id="sliderWrap">
            <div class="slider-track" id="track">
                <% if (bestProducts && bestProducts.length > 0) { %>
                    <% bestProducts.forEach((item, i) => { %>
                        <div class="slide">
                            <div class="slide-img-col">
                                <img src="<%= item.image_url %>" alt="<%= item.name %>" onerror="this.src='/images/default.jpg'">
                            </div>
                            <div class="slide-info-col">
                                <div><span class="slide-rank">BEST 0<%= i+1 %></span></div>
                                <div class="slide-name"><%= item.name %></div>
                                
                                <div class="star-rating-display">
                                    <% 
                                        let bAvg = parseFloat(item.rating || 0);
                                        let bFull = Math.floor(bAvg); 
                                        let bHalf = (bAvg % 1) >= 0.5; 
                                        let bEmpty = 5 - bFull - (bHalf ? 1 : 0);
                                    %>
                                    <% for(let k=0; k<bFull; k++){ %><span class="star full">&#9733;</span><% } %>
                                    <% if(bHalf){ %><span class="star half">&#9733;</span><% } %>
                                    <% for(let k=0; k<bEmpty; k++){ %><span class="star empty">&#9734;</span><% } %>
                                    <span class="rating-value"><%= bAvg.toFixed(1) %></span>
                                </div>
                                
                                <div class="slide-price"><%= item.price.toLocaleString() %><em>원</em></div>
                                <a href="/product/<%= item.id %>"><div class="slide-cta">상품 보러가기  →</div></a>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="slide">
                        <div class="slide-info-col" style="width:100%;align-items:center;text-align:center">
                            <div style="color:#ccc;font-size:15px;letter-spacing:1px">등록된 상품이 없습니다</div>
                        </div>
                    </div>
                <% } %>
            </div>
            <div class="slider-arrows">
                <div class="arr-btn" id="prevBtn">←</div>
                <div class="arr-btn" id="nextBtn">→</div>
            </div>
            <div class="slider-dots" id="dots"></div>
        </div>

        <div class="sec-hd">
            <span class="sec-ttl">월별 상품</span>
            <span class="sec-en">SEASONAL ITEMS</span>
        </div>

        <div class="month-wrap">
            <div class="month-tabs" id="mTabs"></div>
            <div class="month-grid-wrap" id="mGridWrap">
                <% const catIcon = currentCategory==='수산물' ? '🐟' : currentCategory==='농산물' ? '🥦' : '👕' %>
                <% for(let m = 1; m <= 6; m++) { %>
                    <div class="m-col" data-col="<%= m %>">
                        <div class="m-col-header"><%= m %>월</div>
                        <% if(monthlyData && monthlyData[m] && monthlyData[m].length > 0){ %>
                            <% for(let i = 0; i < 5; i++){ %>
                                <% if(monthlyData[m][i]){ %>
                                    <a href="/product/<%= monthlyData[m][i].id %>">
                                        <div class="m-card">
                                            <img src="<%= monthlyData[m][i].image_url %>" class="m-img" alt="<%= monthlyData[m][i].name %>" onerror="this.src='/images/default.jpg'">
                                            <div class="m-body">
                                                <div class="m-name"><%= monthlyData[m][i].name %></div>
                                                
                                                <div class="star-rating-display">
                                                    <% 
                                                        let mAvg = parseFloat(monthlyData[m][i].rating || 0);
                                                        let mFull = Math.floor(mAvg); 
                                                        let mHalf = (mAvg % 1) >= 0.5; 
                                                        let mEmpty = 5 - mFull - (mHalf ? 1 : 0);
                                                    %>
                                                    <% for(let k=0; k<mFull; k++){ %><span class="star full">&#9733;</span><% } %>
                                                    <% if(mHalf){ %><span class="star half">&#9733;</span><% } %>
                                                    <% for(let k=0; k<mEmpty; k++){ %><span class="star empty">&#9734;</span><% } %>
                                                    <span class="rating-value"><%= mAvg.toFixed(1) %></span>
                                                </div>
                                                
                                                <div class="m-price"><%= monthlyData[m][i].price.toLocaleString() %>원</div>
                                            </div>
                                            <span class="m-cat-icon"><%= catIcon %></span>
                                        </div>
                                    </a>
                                <% } else { %>
                                    <div class="m-empty-card"><span class="m-empty-txt">— 준비중 —</span></div>
                                <% } %>
                            <% } %>
                        <% } else { %>
                            <% for(let i = 0; i < 5; i++){ %>
                                <div class="m-empty-card"><span class="m-empty-txt">— 준비중 —</span></div>
                            <% } %>
                        <% } %>
                    </div>
                <% } %>
                <% for(let m = 7; m <= 12; m++) { %>
                    <div class="m-col" data-col="<%= m %>" style="display:none">
                        <div class="m-col-header"><%= m %>월</div>
                        <% if(monthlyData && monthlyData[m] && monthlyData[m].length > 0){ %>
                            <% for(let i = 0; i < 5; i++){ %>
                                <% if(monthlyData[m][i]){ %>
                                    <a href="/product/<%= monthlyData[m][i].id %>">
                                        <div class="m-card">
                                            <img src="<%= monthlyData[m][i].image_url %>" class="m-img" alt="<%= monthlyData[m][i].name %>" onerror="this.src='/images/default.jpg'">
                                            <div class="m-body">
                                                <div class="m-name"><%= monthlyData[m][i].name %></div>
                                                
                                                <div class="star-rating-display">
                                                    <% 
                                                        let mAvg2 = parseFloat(monthlyData[m][i].rating || 0);
                                                        let mFull2 = Math.floor(mAvg2); 
                                                        let mHalf2 = (mAvg2 % 1) >= 0.5; 
                                                        let mEmpty2 = 5 - mFull2 - (mHalf2 ? 1 : 0);
                                                    %>
                                                    <% for(let k=0; k<mFull2; k++){ %><span class="star full">&#9733;</span><% } %>
                                                    <% if(mHalf2){ %><span class="star half">&#9733;</span><% } %>
                                                    <% for(let k=0; k<mEmpty2; k++){ %><span class="star empty">&#9734;</span><% } %>
                                                    <span class="rating-value"><%= mAvg2.toFixed(1) %></span>
                                                </div>
                                                
                                                <div class="m-price"><%= monthlyData[m][i].price.toLocaleString() %>원</div>
                                            </div>
                                            <span class="m-cat-icon"><%= catIcon %></span>
                                        </div>
                                    </a>
                                <% } else { %>
                                    <div class="m-empty-card"><span class="m-empty-txt">— 준비중 —</span></div>
                                <% } %>
                            <% } %>
                        <% } else { %>
                            <% for(let i = 0; i < 5; i++){ %>
                                <div class="m-empty-card"><span class="m-empty-txt">— 준비중 —</span></div>
                            <% } %>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>
    </aside>
</div>

<script>
    const track = document.getElementById('track');
    const slides = track.querySelectorAll('.slide');
    const dotsWrap = document.getElementById('dots');
    const total = slides.length;
    let cur = 0, timer;

    slides.forEach((_,i)=>{
        const d = document.createElement('div');
        d.className = 'dot'+(i===0?' on':'');
        d.onclick = ()=>go(i);
        dotsWrap.appendChild(d);
    });

    function go(n){
        cur = (n+total)%total;
        track.style.transform = 'translateX(-'+(cur*100)+'%)';
        dotsWrap.querySelectorAll('.dot').forEach((d,i)=>d.className='dot'+(i===cur?' on':''));
    }
    function startAuto(){ timer = setInterval(()=>go(cur+1), 3800); }
    function stopAuto(){ clearInterval(timer); }

    document.getElementById('prevBtn').onclick = ()=>{stopAuto();go(cur-1);startAuto()};
    document.getElementById('nextBtn').onclick = ()=>{stopAuto();go(cur+1);startAuto()};
    document.getElementById('sliderWrap').onmouseenter = stopAuto;
    document.getElementById('sliderWrap').onmouseleave = startAuto;
    startAuto();

    let groupOpen = false;
    function toggleHalfGroup() {
        groupOpen = !groupOpen;
        document.getElementById('hfGroup').classList.toggle('open', groupOpen);
    }

    let activePage = 1;
    let activeMonth = null;

    function renderTabs(page) {
        const tabs = document.getElementById('mTabs');
        tabs.innerHTML = '';
        const start = page === 1 ? 1 : 7;
        const end   = page === 1 ? 6 : 12;
        for(let m = start; m <= end; m++) {
            const t = document.createElement('div');
            t.className = 'm-tab' + (m === activeMonth ? ' on' : '');
            t.dataset.m = m;
            t.textContent = m + '월';
            t.onclick = () => selectMonth(m);
            tabs.appendChild(t);
        }
    }

    function selectMonth(m) {
        activeMonth = m;
        document.querySelectorAll('.m-tab').forEach(t => t.classList.remove('on'));
        const activeTab = document.querySelector('.m-tab[data-m="'+m+'"]');
        if(activeTab) activeTab.classList.add('on');
        document.querySelectorAll('.m-col').forEach(col => {
            col.classList.toggle('highlight', Number(col.dataset.col) === m);
        });
    }

    function switchGroup(page) {
        activePage = page;
        document.getElementById('mgBtn1').classList.toggle('on', page === 1);
        document.getElementById('mgBtn2').classList.toggle('on', page === 2);
        document.querySelectorAll('.m-col').forEach(col => {
            const cm = Number(col.dataset.col);
            col.style.display = (page === 1 ? cm <= 6 : cm >= 7) ? '' : 'none';
            col.classList.remove('highlight');
        });
        activeMonth = null;
        renderTabs(page);
        selectMonth(page === 1 ? 1 : 7);
    }

    const curMonth = new Date().getMonth() + 1;
    const initPage = curMonth <= 6 ? 1 : 2;
    activePage = initPage;
    document.getElementById('mgBtn1').classList.toggle('on', initPage === 1);
    document.getElementById('mgBtn2').classList.toggle('on', initPage === 2);
    document.querySelectorAll('.m-col').forEach(col => {
        const cm = Number(col.dataset.col);
        col.style.display = (initPage === 1 ? cm <= 6 : cm >= 7) ? '' : 'none';
    });
    renderTabs(initPage);
    selectMonth(curMonth);

    function getHistory() {
        return JSON.parse(localStorage.getItem('searchHistory') || '[]');
    }
    function saveHistory(kw) {
        let h = getHistory();
        h = h.filter(x => x !== kw);
        h.unshift(kw);
        if(h.length > 10) h = h.slice(0, 10);
        localStorage.setItem('searchHistory', JSON.stringify(h));
    }
    function deleteHistory(kw) {
        localStorage.setItem('searchHistory', JSON.stringify(getHistory().filter(x => x !== kw)));
        renderHistory();
    }
    function clearAll() {
        localStorage.removeItem('searchHistory');
        renderHistory();
    }
    function renderHistory() {
        const h = getHistory();
        const list = document.getElementById('historyList');
        if(!list) return;
        if(h.length === 0) {
            list.innerHTML = '<div class="no-history">최근 검색어가 없습니다</div>';
            return;
        }
        list.innerHTML = h.map(x => `
            <div class="history-item">
                <div class="history-left" onclick="selectHistory('${x.replace(/'/g,"\\'")}')">
                    <span class="history-clock">🕐</span>
                    <span class="history-text">${x}</span>
                </div>
                <button class="history-del" onclick="event.stopPropagation(); deleteHistory('${x.replace(/'/g,"\\'")}')">×</button>
            </div>
        `).join('');
    }
    function selectHistory(kw) {
        document.getElementById('searchInput').value = kw;
        doSearch();
    }
    function showDropdown() {
        renderHistory();
        document.getElementById('searchDropdown').classList.add('show');
    }
    function hideDropdown() {
        document.getElementById('searchDropdown').classList.remove('show');
    }
    function doSearch() {
        const kw = document.getElementById('searchInput').value.trim();
        if(!kw) return alert('검색어를 입력해주세요!');
        saveHistory(kw);
        location.href = '/search?q=' + encodeURIComponent(kw);
    }
    function handleKey(e) {
        if(e.key === 'Enter') doSearch();
    }
    document.addEventListener('click', function(e) {
        const outer = document.getElementById('searchOuter');
        if(outer && !outer.contains(e.target)) hideDropdown();
    });
</script>
</body>
</html>