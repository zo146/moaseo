<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title><%= product.name %> - 모아서 프리미엄 마켓</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .detail-container { max-width: 1000px; margin: 60px auto 20px auto; background: #fff; display: flex; padding: 50px; border: 1px solid var(--line); gap: 50px; }
        .product-img-box { flex: 1; display: flex; align-items: center; justify-content: center; background: #faf9f7; border: 1px solid var(--line); }
        .product-img { width: 100%; max-height: 500px; object-fit: contain; }
        .info-box { flex: 1; display: flex; flex-direction: column; }
        .category-tag { display: inline-block; color: #888; font-size: 12px; font-weight: 700; letter-spacing: 1px; margin-bottom: 15px; }
        .product-name { font-size: 28px; font-weight: 900; letter-spacing: -1px; margin-bottom: 8px; color: var(--p); line-height: 1.3; }
        .price { font-size: 32px; color: var(--p); font-weight: 900; margin-bottom: 30px; border-bottom: 2px solid var(--p); padding-bottom: 20px; }
        .detail-row { display: flex; margin-bottom: 16px; font-size: 14px; align-items: center; }
        .detail-row .label { width: 100px; color: #666; font-weight: 700; letter-spacing: 0.5px; }
        .detail-row .value { color: var(--p); }
        .order-box { margin-top: auto; padding-top: 30px; border-top: 1px solid var(--line); }
        .quantity-select { display: flex; align-items: center; margin-bottom: 20px; justify-content: space-between; }
        .quantity-input { width: 80px; padding: 10px; border: 1px solid var(--line); outline: none; font-size: 15px; text-align: center; }
        .btn-group { display: flex; gap: 10px; margin-bottom: 20px; }
        .back-link { display: block; text-align: center; color: #888; text-decoration: none; font-size: 13px; font-weight: 700; }
        .review-container { max-width: 1000px; margin: 0 auto 60px auto; background: #fff; padding: 50px; border: 1px solid var(--line); }
        .review-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--p); padding-bottom: 20px; margin-bottom: 30px; }
        .review-header h3 { font-size: 24px; font-weight: 900; color: var(--p); margin: 0; }
        .review-form { margin-bottom: 40px; background: #faf9f7; padding: 20px; border: 1px solid var(--line); }
        .review-form textarea { width: 100%; padding: 10px; margin-top: 10px; border: 1px solid var(--line); outline: none; resize: vertical; min-height: 80px; }
        .review-list-item { border-bottom: 1px solid #eee; padding: 20px 0; }
        .review-meta { display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 14px; }
        .review-author { font-weight: 700; color: var(--p); }
        .review-stars { color: #ff9900; letter-spacing: 2px; }
        .star-rating-display { font-size: 20px; color: #ddd; position: relative; display: inline-block; }
        .star-rating-display .star { position: relative; display: inline-block; }
        .star-rating-display .star.full { color: #ff9900; }
        .star-rating-display .star.half::before { content: '\2605'; color: #ff9900; position: absolute; left: 0; width: 50%; overflow: hidden; }
        .action-btn { background: none; border: 1px solid #ccc; padding: 4px 8px; font-size: 12px; cursor: pointer; margin-left: 5px; border-radius: 4px; color: #666; }
        .action-btn:hover { background: #f0f0f0; }
    </style>
</head>
<body>
<% 
    let rAvg = parseFloat(avgRating || 0);
    let fStars = Math.floor(rAvg); 
    let hStar = (rAvg % 1) >= 0.5; 
    let eStars = 5 - fStars - (hStar ? 1 : 0);
%>
<div style="background:#fff; padding:20px; text-align:center; border-bottom:1px solid var(--line);">
    <a href="/" style="font-size:24px; font-weight:900; color:#1a1a1a; letter-spacing:-1.5px; line-height:1; display:block;">모아서</a>
    <span style="font-size:9.5px; letter-spacing:3px; color:#aaa; text-transform:uppercase;">premium market</span>
</div>

    <div class="detail-container">
        <div class="product-img-box">
            <img src="<%= product.image_url %>" alt="<%= product.name %>" class="product-img" onerror="this.src='/images/default.jpg'">
        </div>

        <div class="info-box">
            <div class="category-tag"><%= product.category %> / BEST ITEM</div>
            <h1 class="product-name"><%= product.name %></h1>
            
            <div id="top-rating-container" style="margin-bottom: 20px; font-size: 14px; cursor: pointer;" onclick="window.scrollTo({top: document.querySelector('.review-container').offsetTop, behavior: 'smooth'})">
                <% if (totalReviews > 0) { %>
                    <div class="star-rating-display">
                        <% for(let i=0; i<fStars; i++){ %><span class="star full">&#9733;</span><% } %>
                        <% if(hStar){ %><span class="star half">&#9733;</span><% } %>
                        <% for(let i=0; i<eStars; i++){ %><span class="star empty">&#9734;</span><% } %>
                    </div>
                    <strong style="color: var(--p); font-size: 16px; margin-left: 5px;"><%= avgRating %></strong>
                    <span style="color: #888; margin-left: 5px; text-decoration: underline;"><%= totalReviews %>개의 리뷰 보기</span>
                <% } else { %>
                    <span style="color: #999;">작성된 리뷰가 없습니다</span>
                <% } %>
            </div>

            <div class="price"><%= product.price.toLocaleString() %>원</div>

            <div class="detail-row"><span class="label">원산지</span><span class="value"><%= product.origin || '정보 없음' %></span></div>
            <div class="detail-row"><span class="label">배송료</span><span class="value"><%= product.shipping_fee.toLocaleString() %>원</span></div>
            <div class="detail-row"><span class="label">남은수량</span><span class="value"><%= product.stock %>개</span></div>

            <form action="/cart/add" method="POST" class="order-box">
                <input type="hidden" name="product_id" value="<%= product.id %>">
                <div class="quantity-select">
                    <span class="label">주문수량</span>
                    <div style="display: flex; align-items: center;">
                        <input type="number" name="quantity" class="quantity-input" value="1" min="1" max="<%= product.stock %>">
                        <span style="margin-left: 8px; font-size: 14px; color: #666;">개</span>
                    </div>
                </div>
                <div class="btn-group">
                    <button type="submit" class="btn-outline" style="flex: 1;">장바구니 담기</button>
                    <button type="button" class="btn-primary" style="flex: 1;" onclick="directOrder('<%= product.id %>')">바로 구매하기</button>
                </div>
            </form>
            <a href="javascript:history.back()" class="back-link">← 리스트로 돌아가기</a>
        </div>
    </div>

    <div class="review-container">
        <div class="review-header">
            <h3>⭐ 고객 리뷰 (<%= totalReviews %>건)</h3>
            <div style="display: flex; align-items: center; gap: 10px;">
                <% if (totalReviews > 0) { %>
                    <div class="star-rating-display">
                        <% for(let i=0; i<fStars; i++){ %><span class="star full">&#9733;</span><% } %>
                        <% if(hStar){ %><span class="star half">&#9733;</span><% } %>
                        <% for(let i=0; i<eStars; i++){ %><span class="star empty">&#9734;</span><% } %>
                    </div>
                <% } %>
                <h2 style="font-size: 20px; color: #ff9900; margin: 0;"><%= avgRating %> / 5.0</h2>
            </div>
        </div>

        <div class="review-form">
            <h4 style="margin:0 0 10px 0; color:var(--p);">리뷰 작성하기</h4>
            <select id="rating-select" style="width: 100%; padding: 10px; border: 1px solid var(--line);">
                <option value="5">⭐⭐⭐⭐⭐ (5점)</option>
                <option value="4">⭐⭐⭐⭐ (4점)</option>
                <option value="3">⭐⭐⭐ (3점)</option>
                <option value="2">⭐⭐ (2점)</option>
                <option value="1">⭐ (1점)</option>
            </select>
            <textarea id="review-content" placeholder="상품에 대한 솔직한 리뷰를 남겨주세요 (로그인 필요)"></textarea>
            <button id="submit-review-btn" class="btn-primary" style="margin-top:15px; width:100%;">리뷰 등록</button>
        </div>
        
        <div id="review-list">
            <% if (reviews && reviews.length > 0) { %>
                <% reviews.forEach(function(review) { %>
                    <div class="review-list-item">
                        <div class="review-meta" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                            <span class="review-author" style="font-weight: 700; color: var(--p);">
                                <%= review.user_name || review.userid ? (review.user_name || review.userid) + ' 님' : '익명 사용자' %>
                            </span>
                            <div style="display: flex; align-items: center;">
                                <span style="color: #999; font-size: 14px; margin-right: 10px;">
                                    <%= new Date(review.created_at).toLocaleDateString() %>
                                </span>
                                <% if (typeof user !== 'undefined' && user) { %>
                                    <% if (user.id === review.user_id) { %>
                                        <button class="action-btn" onclick="editReview('<%= review.review_id %>', '<%= review.rating %>', '<%= review.content.replace(/\'/g, "\\'") %>')">수정</button>
                                    <% } %>
                                    <% if (user.id === review.user_id || user.role === 'admin') { %>
                                        <button class="action-btn" onclick="deleteReview('<%= review.review_id %>')">삭제</button>
                                    <% } %>
                                <% } %>
                            </div>
                        </div>
                        <div class="review-stars"><%= '⭐'.repeat(review.rating) %></div>
                        <p style="margin-top: 10px; color: #444; line-height: 1.5;"><%= review.content %></p>
                    </div>
                <% }); %>
            <% } else { %>
                <p style="text-align:center; color:#888; padding:30px 0;">아직 작성된 리뷰가 없습니다.</p>
            <% } %>
        </div>
    </div>

<script>
function directOrder(productId) {
    const qty = document.querySelector('input[name="quantity"]').value;
    fetch('/cart/add/direct', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ product_id: productId, quantity: qty })
    })
    .then(res => res.json())
    .then(data => {
        if(data.success) { location.href = '/checkout'; } 
        else { alert(data.message || '로그인이 필요합니다.'); if(data.redirect) location.href = data.redirect; }
    });
}

const productId = '<%= product.id %>'; 

document.getElementById('submit-review-btn').addEventListener('click', async () => {
    const rating = document.getElementById('rating-select').value;
    const content = document.getElementById('review-content').value.trim();
    if (!content) { alert('리뷰 내용을 입력해주세요.'); return; }

    try {
        const response = await fetch('/reviews', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ product_id: productId, rating, content })
        });
        
        if (response.status === 201) { 
            alert('리뷰가 성공적으로 등록되었습니다!'); 
            location.reload(); 
        } 
        else if (response.status === 400) { alert('이미 이 상품에 리뷰를 작성하셨습니다.'); } 
        else if (response.status === 401) { alert('로그인이 필요합니다.'); location.href = '/login'; }
        else { alert('서버 오류가 발생했습니다.'); }
    } catch (error) { 
        alert('서버 오류가 발생했습니다.'); 
    }
});

async function editReview(reviewId, currentRating, currentContent) {
    const newContent = prompt('수정할 내용을 입력하세요:', currentContent);
    if (newContent === null) return;
    if (newContent.trim() === '') { alert('내용을 입력해주세요.'); return; }
    
    let newRating = prompt('수정할 별점을 입력하세요 (1~5):', currentRating);
    if (newRating === null) return;
    newRating = parseInt(newRating);
    if (isNaN(newRating) || newRating < 1 || newRating > 5) { alert('1에서 5 사이의 숫자를 입력해주세요.'); return; }

    try {
        const response = await fetch('/reviews/' + reviewId, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ rating: String(newRating), content: newContent })
        });
        
        if (response.ok) { 
            location.reload(); 
        } else { 
            const data = await response.json();
            alert(data.error || '수정 실패'); 
        }
    } catch (error) {
        alert('서버 오류가 발생했습니다.');
    }
}

async function deleteReview(reviewId) {
    if (!confirm('이 리뷰를 삭제하시겠습니까?')) return;

    try {
        const response = await fetch('/reviews/' + reviewId, {
            method: 'DELETE'
        });
        
        if (response.ok) { 
            location.reload(); 
        } else { 
            const data = await response.json();
            alert(data.error || '삭제 실패'); 
        }
    } catch (error) {
        alert('서버 오류가 발생했습니다.');
    }
}
</script>
</body>
</html>