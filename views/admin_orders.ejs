<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>모아서 ADMIN - 주문 관리</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/all.min.css">
    <style>
        body { background-color: #f8f9fa; font-family: 'Pretendard', sans-serif; margin: 0; color: #333; }
        header { background-color: #1a1a1a; color: white; padding: 15px 40px; display: flex; justify-content: space-between; align-items: center; }
        .container { padding: 40px; max-width: 1400px; margin: 0 auto; }
        
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: white; padding: 20px; border-radius: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); border-top: 4px solid #3498db; }
        
        .card { background: white; border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); overflow: hidden; }
        .card-header { padding: 20px 30px; border-bottom: 1px solid #eee; background: #fff; }
        
        table { width: 100%; border-collapse: collapse; }
        th { background: #f9f9f9; padding: 15px; text-align: left; font-size: 14px; color: #666; border-bottom: 2px solid #eee; }
        td { padding: 15px; font-size: 14px; border-bottom: 1px solid #f1f1f1; }
        
        .order-row:hover { background: #f8f9ff; cursor: pointer; }
        .badge { padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: bold; background: #e8f5e9; color: #2e7d32; }

        /* 상세 내역 숨김 처리 */
        .order-detail { display: none; background: #fafafa; padding: 15px; border-bottom: 1px solid #ddd; }
        .detail-img { width: 50px; height: 50px; object-fit: cover; border-radius: 5px; margin-right: 15px; }
    </style>
</head>
<body>
    <header>
        <div style="font-size: 20px; font-weight: bold;">MOASEO ADMIN</div>
        <button onclick="location.href='/admin/list'" style="background:none; color:white; border:1px solid white; padding:5px 15px; cursor:pointer; border-radius:5px;">목록으로</button>
    </header>

    <div class="container">
        <div class="stats-grid">
            <div class="stat-card">
                <p style="color:#888; font-size:13px; margin:0;">총 주문</p>
                <p style="font-size:22px; font-weight:bold; margin:5px 0 0;"><%= orders.length %>건</p>
            </div>
            <% categoryStats.forEach(stat => { %>
            <div class="stat-card">
                <p style="color:#888; font-size:13px; margin:0;"><%= stat.category %> 누적 판매</p>
                <p style="font-size:22px; font-weight:bold; margin:5px 0 0;"><%= stat.total %>개</p>
            </div>
            <% }) %>
        </div>

        <div class="card">
            <div class="card-header"><h2>최신 주문 내역</h2></div>
            <table>
                <thead>
                    <tr>
                        <th>주문번호</th>
                        <th>수령인</th>
                        <th>연락처</th>
                        <th>주소</th>
                        <th>결제금액</th>
                        <th>주문일시</th>
                        <th>상태</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(orders.length > 0) { %>
                        <% orders.forEach(order => { %>
                            <tr class="order-row" onclick="toggleDetail('<%= order.id %>')">
                                <td>#<%= order.id %></td>
                                <td><strong><%= order.receiver_name %></strong></td>
                                <td><%= order.receiver_phone %></td>
                                <td><%= order.address %> <%= order.address_detail %></td>
                                <td><%= order.total_price.toLocaleString() %>원</td>
                                <td><%= new Date(order.created_at).toLocaleString() %></td>
                                <td><span class="badge"><%= order.status %></span></td>
                            </tr>
                            <tr id="detail-<%= order.id %>" class="order-detail">
                                <td colspan="7">
                                    <div style="display:flex; flex-direction:column; gap:10px; padding-left:20px;">
                                        <strong>📦 주문 상품 목록:</strong>
                                        <% order.items.forEach(item => { %>
                                            <div style="display:flex; align-items:center;">
                                                <img src="<%= item.image_url %>" class="detail-img">
                                                <span><%= item.name %> (<%= item.price.toLocaleString() %>원) - <strong><%= item.quantity %>개</strong></span>
                                            </div>
                                        <% }) %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="7" style="text-align:center; padding:50px;">주문 내역이 없습니다.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        function toggleDetail(id) {
            const detailRow = document.getElementById('detail-' + id);
            if (detailRow.style.display === 'table-row') {
                detailRow.style.display = 'none';
            } else {
                detailRow.style.display = 'table-row';
            }
        }
    </script>
</body>
</html>