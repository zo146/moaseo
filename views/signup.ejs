<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>회원가입 - 모아서 프리미엄 마켓</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* 로그인/회원가입 공통 화면 정렬 스타일 */
        body { 
            display: flex; 
            align-items: center; 
            min-height: 100vh; 
            background: #f8f8f6; 
        }
        .auth-logo {
            text-align: center;
            margin-bottom: 30px;
        }
        .auth-logo .text {
            font-size: 32px; font-weight: 900; letter-spacing: -1.5px; color: #1a1a1a; display: block; line-height: 1;
        }
        .auth-logo .sub {
            font-size: 10px; letter-spacing: 3px; color: #aaa; margin-top: 6px; text-transform: uppercase; display: block;
        }
        .auth-links {
            margin-top: 24px;
            text-align: center;
            font-size: 13px;
            color: #888;
        }
        .auth-links a {
            color: var(--p);
            font-weight: 700;
            transition: color 0.2s;
        }
        .auth-links a:hover {
            color: var(--acc);
        }
    </style>
</head>
<body>

    <div class="sub-page-wrap" style="width: 100%; max-width: 440px;">
        
        <div class="auth-logo">
            <a href="/">
                <span class="text">모아서</span>
                <span class="sub">premium market</span>
            </a>
        </div>

        <h1 class="sub-page-title" style="font-size: 18px; letter-spacing: 2px;">JOIN US</h1>
        
        <form action="/signup" method="POST">
            <div class="form-group">
                <label class="form-label">아이디</label>
                <input type="text" name="userid" class="form-input" placeholder="사용할 아이디를 입력하세요" required>
            </div>
            <div class="form-group">
                <label class="form-label">비밀번호</label>
                <input type="password" name="password" class="form-input" placeholder="비밀번호를 입력하세요" required>
            </div>
            <div class="form-group">
                <label class="form-label">이름</label>
                <input type="text" name="username" class="form-input" placeholder="이름을 입력하세요" required>
            </div>
            
            <button type="submit" class="btn-primary" style="margin-top: 10px;">가입하기</button>
        </form>
        
        <div class="auth-links">
            <a href="/login">이미 계정이 있으신가요? 로그인</a>
        </div>
        
    </div>

</body>
</html>